<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31–37). База, ключ базы и настройки не уходят ни в облачный бэкап, ни на новый телефон
    (spec data-encryption, «Исключение из бэкапа»): исключены все домены.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
