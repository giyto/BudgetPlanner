<?xml version="1.0" encoding="utf-8"?>
<!-- Превью в списке виджетов лаунчера (Android 12+), повторяет маленький виджет из макета Widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_can_spend"
        android:textColor="#FFB9BEC7"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_amount"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
