<?xml version="1.0" encoding="utf-8"?>
<!-- Превью большого виджета в списке виджетов лаунчера (Android 12+), повторяет средний виджет из макета Widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_can_spend"
            android:textColor="#FFB9BEC7"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_amount"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- ImageView, а не View: в виджетах (RemoteViews) простой View не поддерживается. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_track" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:text="@string/widget_preview_limit"
            android:textColor="#FFB9BEC7"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_preview_plus_background"
        android:contentDescription="@null"
        android:padding="14dp"
        android:src="@drawable/ic_widget_add" />
</LinearLayout>
