<?xml version="1.0" encoding="utf-8"?>
<!-- Полоса лимита на превью большого виджета: четверть потрачена. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2E3338" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:right="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF5EE0A8" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
